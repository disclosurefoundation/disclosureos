{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "vocabulary_bindings"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "bindings": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "recordedAt": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "pattern": "^(?!0000)"
            },
            {
              "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}"
            },
            {
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
            }
          ]
        },
        "assignedBy": {
          "$ref": "#/$defs/__schema2"
        },
        "rationale": {
          "$ref": "#/$defs/__schema2"
        },
        "claim": {
          "type": "object",
          "properties": {
            "document": {
              "$ref": "#/$defs/__schema3"
            },
            "claimId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "document",
            "claimId"
          ],
          "additionalProperties": false
        },
        "relation": {
          "type": "string",
          "enum": [
            "about",
            "assessment_criterion"
          ]
        },
        "term": {
          "type": "object",
          "properties": {
            "catalogId": {
              "type": "string",
              "pattern": "^(?:urn:[A-Za-z0-9][A-Za-z0-9-]*:[^\\s]+|https:\\/\\/[^\\s/?#]+(?:\\/[^\\s]*)?)(?![\\s\\S])"
            },
            "revision": {
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?![ \\t\\r\\n]*[Ll][Aa][Tt][Ee][Ss][Tt][ \\t\\r\\n]*$)[\\s\\S]+$"
                }
              ],
              "$ref": "#/$defs/__schema2"
            },
            "document": {
              "$ref": "#/$defs/__schema3"
            },
            "termId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "catalogId",
            "revision",
            "document",
            "termId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "recordedAt",
        "assignedBy",
        "rationale",
        "claim",
        "relation",
        "term"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
          "description": "ID inside the supplied document; not a URL."
        },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Exact document contract identity."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
          "description": "SHA-256 of exact supplied document bytes."
        }
      },
      "required": [
        "documentId",
        "schemaId",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:disclosureos:experimental:vocabulary-bindings:0.1.0"
}
