{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "legacy_sensor_revision_review"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "pattern": "^(?!0000)"
        },
        {
          "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}"
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "bytes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sha256",
        "byteLength",
        "bytes"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sensorPointer": {
            "type": "string",
            "pattern": "^\\/sensorEvidence\\/sensors\\/(?:0|[1-9][0-9]*)\\/sensorRef(?![\\s\\S])"
          },
          "legacyRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "acquisitionRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "manifest": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "bytes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sha256",
              "byteLength",
              "bytes"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "bytes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sha256",
              "byteLength",
              "bytes"
            ],
            "additionalProperties": false
          },
          "provenanceLocator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "sourceId",
          "sensorPointer",
          "legacyRef",
          "acquisitionRef",
          "manifest",
          "provenance",
          "provenanceLocator",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "source",
    "namespace",
    "reviewedBy",
    "reviewedAt",
    "context",
    "decisions"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:migration-compatibility:0.1.0"
}
