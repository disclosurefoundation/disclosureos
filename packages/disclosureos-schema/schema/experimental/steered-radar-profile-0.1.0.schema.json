{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "contextId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "sourceSelectionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "acquisitionRef": {
      "type": "string",
      "pattern": "^acquisition:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "acquisitionProductRef": {
      "type": "string",
      "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "channelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "frameRef": {
      "type": "string",
      "pattern": "^frame:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "origin": {
      "type": "object",
      "properties": {
        "eastM": {
          "type": "number"
        },
        "northM": {
          "type": "number"
        }
      },
      "required": [
        "eastM",
        "northM"
      ],
      "additionalProperties": false
    },
    "timeOrigin": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "dataOrigin": {
      "type": "string",
      "enum": [
        "synthetic",
        "instrument"
      ]
    },
    "bearingConvention": {
      "type": "string",
      "const": "clockwise_from_north"
    },
    "kind": {
      "type": "string",
      "const": "steered_radar_profile"
    },
    "mode": {
      "type": "string",
      "const": "electronically_steered_sector"
    },
    "rangeConvention": {
      "type": "string",
      "const": "horizontal_range"
    },
    "beamWidthConvention": {
      "type": "string",
      "const": "full_width_half_maximum_power"
    },
    "processingAvailability": {
      "type": "string",
      "const": "dwell_end"
    },
    "detectionPosition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cell_center"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "products": {
      "type": "object",
      "properties": {
        "beamSchedule": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "returns": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "thresholds": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "detections": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "tracks": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "associations": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "truth": {
          "type": "string",
          "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        }
      },
      "required": [
        "beamSchedule",
        "returns",
        "thresholds",
        "detections",
        "tracks",
        "associations"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "gaussian_position_covariance"
        },
        "axes": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "east"
            },
            {
              "type": "string",
              "const": "north"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "unit": {
          "type": "string",
          "const": "m2"
        },
        "confidenceProbability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "kind",
        "axes",
        "unit",
        "confidenceProbability"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "observationId",
    "contextId",
    "sourceSelectionId",
    "acquisitionRef",
    "acquisitionProductRef",
    "channelId",
    "frameRef",
    "origin",
    "timeOrigin",
    "dataOrigin",
    "bearingConvention",
    "kind",
    "mode",
    "rangeConvention",
    "beamWidthConvention",
    "processingAvailability",
    "detectionPosition",
    "products",
    "uncertainty"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:steered-radar-profile:0.1.0"
}
