{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "reproduction_packet"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "researchProfile": {
      "type": "string",
      "const": "urn:disclosureos:experimental:profile:instrument-research-prerequisites:0.1.0"
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "sha256",
          "byteLength"
        ],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "object",
      "properties": {
        "history": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "context": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "acquisitionBindings": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "measurementBindings": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "review": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        }
      },
      "required": [
        "history",
        "context",
        "acquisitionBindings",
        "measurementBindings",
        "review"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "observation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "fileRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              }
            },
            "required": [
              "ref",
              "fileRef"
            ],
            "additionalProperties": false
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "fileRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              }
            },
            "required": [
              "ref",
              "fileRef"
            ],
            "additionalProperties": false
          }
        },
        "review": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "fileRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              }
            },
            "required": [
              "ref",
              "fileRef"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "observation",
        "context",
        "review"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inputRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "expectedOutputRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "measurementRef": {
          "type": "string",
          "pattern": "^measurement:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "absoluteTolerance": {
          "type": "number",
          "minimum": 0
        },
        "implementations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              },
              "artifactRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              },
              "environmentRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              }
            },
            "required": [
              "id",
              "artifactRef",
              "environmentRef"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "version",
        "description",
        "inputRef",
        "expectedOutputRef",
        "measurementRef",
        "unit",
        "absoluteTolerance",
        "implementations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "researchProfile",
    "files",
    "documents",
    "assets",
    "method"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:reproduction-packet:0.1.0"
}
