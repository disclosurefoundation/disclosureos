{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "legacy_migration_review"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "pattern": "^(?!0000)"
        },
        {
          "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}"
        }
      ]
    },
    "decisions": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sourcePointers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\/(?:[^~]|~[01])*(?![\\s\\S])"
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "$ref": "#/$defs/__schema0"
              },
              "field": {
                "type": "string",
                "const": "eventTime"
              }
            },
            "required": [
              "sourceId",
              "sourcePointers",
              "rationale",
              "value",
              "field"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sourcePointers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\/(?:[^~]|~[01])*(?![\\s\\S])"
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "$ref": "#/$defs/__schema0"
              },
              "field": {
                "type": "string",
                "const": "position"
              },
              "frames": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              }
            },
            "required": [
              "sourceId",
              "sourcePointers",
              "rationale",
              "value",
              "field",
              "frames"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "namespace",
    "source",
    "reviewedBy",
    "reviewedAt",
    "decisions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "$id": "urn:disclosureos:experimental:migration-review:0.1.0"
}
