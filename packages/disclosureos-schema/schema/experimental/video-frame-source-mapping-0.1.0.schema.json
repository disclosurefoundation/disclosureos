{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "video_frame_source_mapping"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "productRef": {
      "type": "string",
      "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mediaType": {
      "type": "string",
      "pattern": "^video\\/[^\\s]+(?![\\s\\S])"
    },
    "indexer": {
      "type": "object",
      "properties": {
        "methodRef": {
          "type": "string",
          "pattern": "^method:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "methodRef",
        "methodVersion"
      ],
      "additionalProperties": false
    },
    "streams": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "streamIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timeBase": {
            "type": "object",
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "numerator",
              "denominator"
            ],
            "additionalProperties": false
          },
          "presentationTicks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^(?:0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          }
        },
        "required": [
          "streamIndex",
          "timeBase",
          "presentationTicks"
        ],
        "additionalProperties": false
      }
    },
    "selections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "streamIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frameIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "streamIndex",
          "frameIndex"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "observationId",
    "productRef",
    "digest",
    "byteLength",
    "mediaType",
    "indexer",
    "streams",
    "selections"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:video-frame-source-mapping:0.1.0"
}
