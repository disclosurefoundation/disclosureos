{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "legacy_score_preservation_plan"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "pattern": "^(?!0000)"
        },
        {
          "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}"
        }
      ]
    },
    "decisions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourcePointer": {
            "type": "string",
            "pattern": "^(?:|\\/(?:0|[1-9][0-9]*))(?![\\s\\S])"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "resultKind": {
            "type": "string",
            "enum": [
              "completeness",
              "compellingness"
            ]
          },
          "outputContractVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "methodologyVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "sourcePointer",
          "sourceId",
          "resultKind",
          "outputContractVersion",
          "methodologyVersion",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "namespace",
    "source",
    "reviewedBy",
    "reviewedAt",
    "decisions"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:migration-legacy-scores:0.1.0"
}
