{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "dataset_release"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "unknown"
      ]
    },
    "license": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "declared"
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "state",
            "identifier"
          ],
          "additionalProperties": false
        }
      ]
    },
    "packets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "packetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "packetId",
          "sha256",
          "byteLength"
        ],
        "additionalProperties": false
      }
    },
    "sessions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "time": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "state",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "known"
                  },
                  "start": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "end": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "timeScale": {
                    "type": "string",
                    "const": "UTC"
                  }
                },
                "required": [
                  "state",
                  "start",
                  "end",
                  "timeScale"
                ],
                "additionalProperties": false
              }
            ]
          },
          "members": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "packetRef": {
                  "type": "string",
                  "pattern": "^packet:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
                },
                "acquisitionRef": {
                  "type": "string",
                  "pattern": "^acquisition:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
                }
              },
              "required": [
                "packetRef",
                "acquisitionRef"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "time",
          "members"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "createdAt",
    "access",
    "license",
    "packets",
    "sessions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:disclosureos:experimental:dataset-release:0.1.0"
}
