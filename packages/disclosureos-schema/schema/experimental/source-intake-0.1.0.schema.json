{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "source_intake"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "receivedAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "properties": {
        "publisher": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "state",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "declared"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^https:\\/\\/"
        }
      },
      "required": [
        "publisher"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "unknown"
      ]
    },
    "license": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "declared"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "originalName": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "enum": [
              "unknown",
              "native_raw",
              "derived",
              "source_export",
              "documentation"
            ]
          },
          "format": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "state",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "declared"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "state",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "context": {
            "type": "object",
            "properties": {
              "instrument": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "declared"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "calibration": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "declared"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "clock": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "declared"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "acquisitionTime": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "declared"
                      },
                      "kind": {
                        "type": "string",
                        "const": "instant"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "timeScale": {
                        "type": "string",
                        "const": "UTC"
                      }
                    },
                    "required": [
                      "state",
                      "kind",
                      "value",
                      "timeScale"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "declared"
                      },
                      "kind": {
                        "type": "string",
                        "const": "interval"
                      },
                      "start": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "end": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "timeScale": {
                        "type": "string",
                        "const": "UTC"
                      }
                    },
                    "required": [
                      "state",
                      "kind",
                      "start",
                      "end",
                      "timeScale"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "instrument",
              "calibration",
              "clock",
              "acquisitionTime"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "originalName",
          "role",
          "format",
          "sha256",
          "byteLength",
          "context"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "receivedAt",
    "source",
    "access",
    "license",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:disclosureos:experimental:source-intake:0.1.0"
}
