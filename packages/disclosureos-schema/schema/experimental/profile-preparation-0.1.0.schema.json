{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "profile_preparation"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "workflow": {
      "type": "string",
      "enum": [
        "released-documents:0.1.0",
        "historical-testimony:0.1.0",
        "physical-samples:0.1.0"
      ]
    },
    "history": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
    },
    "selection": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "fileRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
          }
        },
        "required": [
          "ref",
          "fileRef",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "vocabularies": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
              }
            },
            "required": [
              "ref",
              "id",
              "version",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "implementation": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
            }
          },
          "required": [
            "ref",
            "id",
            "version",
            "path"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]*\\/)*[A-Za-z0-9][A-Za-z0-9._ -]*(?![\\s\\S])"
            }
          },
          "required": [
            "ref",
            "id",
            "version",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "vocabularies",
        "implementation",
        "environment"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "workflow",
    "history",
    "selection",
    "assets",
    "dependencies"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:profile-preparation:0.1.0"
}
