{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "measurement_bindings"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "historyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "contextId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "acquisitionBindingsId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measurementRef": {
            "type": "string",
            "pattern": "^measurement:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "observationProductRef": {
            "type": "string",
            "pattern": "^product:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "channelId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "time": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "state",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "known"
                  },
                  "kind": {
                    "type": "string",
                    "const": "instant"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeScale": {
                    "type": "string",
                    "const": "UTC"
                  }
                },
                "required": [
                  "state",
                  "kind",
                  "value",
                  "timeScale"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "known"
                  },
                  "kind": {
                    "type": "string",
                    "const": "interval"
                  },
                  "start": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeScale": {
                    "type": "string",
                    "const": "UTC"
                  }
                },
                "required": [
                  "state",
                  "kind",
                  "start",
                  "end",
                  "timeScale"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "measurementRef",
          "observationProductRef",
          "channelId",
          "time"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "historyId",
    "observationId",
    "contextId",
    "acquisitionBindingsId",
    "measurements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:disclosureos:experimental:measurement-bindings:0.1.0"
}
