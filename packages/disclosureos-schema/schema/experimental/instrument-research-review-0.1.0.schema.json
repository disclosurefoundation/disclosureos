{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "instrument_research_review"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "historyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "contextId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "acquisitionBindingsId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "measurementBindingsId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "purpose": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measurementRef": {
            "type": "string",
            "pattern": "^measurement:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "calibrationRef": {
            "type": "string",
            "pattern": "^calibration:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "calibrationUse": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "unreviewed"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "reviewed"
                  },
                  "reviewedBy": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "reviewedAt": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "accepted",
                      "rejected",
                      "inconclusive"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "method": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "report": {
                    "type": "object",
                    "properties": {
                      "digest": {
                        "type": "object",
                        "properties": {
                          "algorithm": {
                            "type": "string",
                            "const": "sha256"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                          }
                        },
                        "required": [
                          "algorithm",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "byteLength": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "digest",
                      "mediaType",
                      "byteLength"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "state",
                  "reviewedBy",
                  "reviewedAt",
                  "outcome",
                  "rationale",
                  "method",
                  "report"
                ],
                "additionalProperties": false
              }
            ]
          },
          "timing": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "bound"
                  },
                  "lower": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "upper": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "timeScale": {
                    "type": "string",
                    "const": "UTC"
                  },
                  "assumptions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "review": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "const": "unreviewed"
                          }
                        },
                        "required": [
                          "state"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "const": "reviewed"
                          },
                          "reviewedBy": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "reviewedAt": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "accepted",
                              "rejected",
                              "inconclusive"
                            ]
                          },
                          "rationale": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "method": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "version": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "description": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "id",
                              "version",
                              "description"
                            ],
                            "additionalProperties": false
                          },
                          "report": {
                            "type": "object",
                            "properties": {
                              "digest": {
                                "type": "object",
                                "properties": {
                                  "algorithm": {
                                    "type": "string",
                                    "const": "sha256"
                                  },
                                  "value": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                                  }
                                },
                                "required": [
                                  "algorithm",
                                  "value"
                                ],
                                "additionalProperties": false
                              },
                              "mediaType": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "byteLength": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "digest",
                              "mediaType",
                              "byteLength"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "state",
                          "reviewedBy",
                          "reviewedAt",
                          "outcome",
                          "rationale",
                          "method",
                          "report"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "lower",
                  "upper",
                  "timeScale",
                  "assumptions",
                  "review"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "coverage_interval"
                  },
                  "lower": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "upper": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "timeScale": {
                    "type": "string",
                    "const": "UTC"
                  },
                  "assumptions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "review": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "const": "unreviewed"
                          }
                        },
                        "required": [
                          "state"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "const": "reviewed"
                          },
                          "reviewedBy": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "reviewedAt": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "accepted",
                              "rejected",
                              "inconclusive"
                            ]
                          },
                          "rationale": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "method": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "version": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "description": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "id",
                              "version",
                              "description"
                            ],
                            "additionalProperties": false
                          },
                          "report": {
                            "type": "object",
                            "properties": {
                              "digest": {
                                "type": "object",
                                "properties": {
                                  "algorithm": {
                                    "type": "string",
                                    "const": "sha256"
                                  },
                                  "value": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                                  }
                                },
                                "required": [
                                  "algorithm",
                                  "value"
                                ],
                                "additionalProperties": false
                              },
                              "mediaType": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "byteLength": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "digest",
                              "mediaType",
                              "byteLength"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "state",
                          "reviewedBy",
                          "reviewedAt",
                          "outcome",
                          "rationale",
                          "method",
                          "report"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "coverageProbability": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  }
                },
                "required": [
                  "kind",
                  "lower",
                  "upper",
                  "timeScale",
                  "assumptions",
                  "review",
                  "coverageProbability"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "measurementRef",
          "calibrationRef",
          "calibrationUse",
          "timing"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "historyId",
    "observationId",
    "contextId",
    "acquisitionBindingsId",
    "measurementBindingsId",
    "purpose",
    "measurements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:disclosureos:experimental:instrument-research-review:0.1.0"
}
