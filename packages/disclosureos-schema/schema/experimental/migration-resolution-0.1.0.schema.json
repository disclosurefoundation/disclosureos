{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "legacy_migration_resolution"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "ledger": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      },
      "required": [
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "decidedBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decidedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "pattern": "^(?!0000)"
        }
      ]
    },
    "decisions": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^legacy-[a-f0-9]{64}(?![\\s\\S])"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "action": {
                "type": "string",
                "const": "select"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "identity",
              "rationale",
              "action",
              "revision"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^legacy-[a-f0-9]{64}(?![\\s\\S])"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "action": {
                "type": "string",
                "const": "defer"
              }
            },
            "required": [
              "identity",
              "rationale",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "ledger",
    "decidedBy",
    "decidedAt",
    "decisions"
  ],
  "additionalProperties": false,
  "$id": "urn:disclosureos:experimental:migration-resolution:0.1.0"
}
